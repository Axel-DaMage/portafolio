# GitHub username queried by the activity widget.
# Optional: falls back to bundled mock data when unset.
VITE_GITHUB_USERNAME=

# GitHub personal access token to raise the API rate limit.
# Optional: the public events endpoint works unauthenticated.
VITE_GITHUB_TOKEN=

# WakaTime API key used to fetch last_7_days coding stats.
# Optional: falls back to bundled mock data when unset.
VITE_WAKATIME_API_KEY=
